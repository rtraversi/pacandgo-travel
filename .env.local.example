# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Anthropic (server-side only — AI deal parser, quote research, profile highlights)
ANTHROPIC_API_KEY=<key>

# Netlify (server-side only — lets the admin panel register agent subdomains
# like kristen.pacandgotravel.com automatically when you add an agent).
# Token: Netlify → User settings → Applications → New access token.
# Without these, agents are still created; you just get a warning and add the
# domain alias by hand in Netlify → Domain management.
NETLIFY_AUTH_TOKEN=<personal-access-token>
NETLIFY_SITE_ID=42d5ecce-871d-44e6-84eb-ca2ab99d904e

# Public site domain — used for agent subdomain URLs
NEXT_PUBLIC_MAIN_DOMAIN=pacandgotravel.com
